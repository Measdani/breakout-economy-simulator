# Supabase Configuration
# Get these from https://supabase.com after creating a project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (never expose to client)
# Get this from Supabase Project Settings > API > Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin authentication via Supabase Auth
# Required. Comma-separated list of email addresses allowed into /admin
ADMIN_ALLOWED_EMAILS=admin@example.com
# Required. Dedicated signing secret for admin session cookies.
# Example: openssl rand -base64 32
ADMIN_SESSION_SECRET=your-admin-session-secret-here

# Optional shared rate limiter for admin login.
# Supports native Upstash Redis env names or Vercel KV env names.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-upstash-rest-token

# Optional: Survey results email copy (configure after domain setup)
# Set to true only after sender domain/provider is fully configured
SURVEY_RESULTS_EMAIL_ENABLED=false
RESEND_API_KEY=your-resend-api-key
SURVEY_RESULTS_EMAIL_FROM=results@your-domain.com
SURVEY_RESULTS_EMAIL_REPLY_TO=support@your-domain.com
APP_BASE_URL=https://your-domain.com
