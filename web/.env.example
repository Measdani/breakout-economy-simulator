# Supabase Configuration
# Get these from https://supabase.com after creating a project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (never expose to client)
# Get this from Supabase Project Settings > API > Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin authentication - use a secure random string
# Example: openssl rand -base64 32
ADMIN_SECRET_KEY=your-secure-admin-secret-here

# Optional: Survey results email copy (configure after domain setup)
# Set to true only after sender domain/provider is fully configured
SURVEY_RESULTS_EMAIL_ENABLED=false
RESEND_API_KEY=your-resend-api-key
SURVEY_RESULTS_EMAIL_FROM=results@your-domain.com
SURVEY_RESULTS_EMAIL_REPLY_TO=support@your-domain.com
APP_BASE_URL=https://your-domain.com
